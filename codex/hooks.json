{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$SUPERSET_HOME_DIR\" ] && [ -x \"$SUPERSET_HOME_DIR/hooks/notify.sh\" ] && \"$SUPERSET_HOME_DIR/hooks/notify.sh\" || true",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "if command -v bun >/dev/null 2>&1; then bun \"$HOME/dotfiles/agents/hooks/capability-suggest.ts\"; fi",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$SUPERSET_HOME_DIR\" ] && [ -x \"$SUPERSET_HOME_DIR/hooks/notify.sh\" ] && \"$SUPERSET_HOME_DIR/hooks/notify.sh\" || true",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "if command -v bun >/dev/null 2>&1; then bun \"$HOME/dotfiles/agents/hooks/run-repo-check.ts\"; fi",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$SUPERSET_HOME_DIR\" ] && [ -x \"$SUPERSET_HOME_DIR/hooks/notify.sh\" ] && \"$SUPERSET_HOME_DIR/hooks/notify.sh\" || true",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "if command -v bun >/dev/null 2>&1; then bun \"$HOME/dotfiles/agents/hooks/check-knowledge-index.ts\" --stop --if-cwd \"${VAULT_DIR:-$HOME/vault}\"; fi",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
